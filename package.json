{
  "name": "wormhole-connector",
  "version": "5.0.1",
  "description": "Wormhole Connector — browser control for Pi-hole and AdGuard Home.",
  "author": "The Wormhole Suite (maintained fork); original project contributors credited in CREDITS.md",
  "contributors": [
    "Thomas Vanhoutte <info@thomasvanhoutte.be>",
    "Marc Proulx <coderlord@gmail.com>",
    "Martin Wiechmann <dev@martinwiechmann.de>",
    "Pascal Glaser <pascal@pglaser.de>",
    "Sebastian Eberhardt <sebastian.eberhardt@live.de>",
    "Benjamin Simmonds <ben.simmonds@outlook.com>",
    "The Wormhole Suite maintainers"
  ],
  "homepage": "https://github.com/The-Wormhole-Suite/wormhole-connector",
  "bugs": {
    "url": "https://github.com/The-Wormhole-Suite/wormhole-connector/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Wormhole-Suite/wormhole-connector.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start-chrome": "npm run start:chrome",
    "start-firefox": "npm run start:firefox",
    "start:chrome": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=development --watch --progress --config src/webpack/webpack.chrome.ts",
    "start:firefox": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=development --watch --progress --config src/webpack/webpack.firefox.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:firefox && npm run build:chrome",
    "build:firefox": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=production --config src/webpack/webpack.firefox.ts --stats=errors-warnings",
    "build:chrome": "cross-env TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --mode=production --config src/webpack/webpack.chrome.ts --stats=errors-warnings",
    "typecheck": "npm run typecheck:ts && npm run typecheck:vue",
    "typecheck:ts": "tsc --noEmit --project tsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "eslint": "npm run lint",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,scss,js,mjs}\" \"tests/**/*.{ts,js,mjs}\" \"scripts/**/*.{js,mjs,cjs}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss,js,mjs}\" \"tests/**/*.{ts,js,mjs}\" \"scripts/**/*.{js,mjs,cjs}\"",
    "prettier-check": "npm run format:check",
    "prettier-format": "npm run format",
    "test": "node scripts/run-tests.mjs",
    "test:domain-status": "node --experimental-strip-types --test tests/domain-status.test.ts",
    "test:badge-state": "node --experimental-strip-types --test tests/badge-state.test.ts",
    "test:status": "npm test",
    "lint:firefox": "cross-env NO_UPDATE_NOTIFIER=1 web-ext lint --source-dir dist/firefox --warnings-as-errors --no-input",
    "validate:packages": "node scripts/validate-packages.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "package:artifacts": "node scripts/prepare-artifacts.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "version:set": "node scripts/set-release-version.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run validate:locales && npm run notices:check && npm test && npm run build && npm run lint:firefox && npm run validate:packages && npm run audit:runtime",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "rebuild-package-lock": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "test:integration:live": "node --import tsx --test tests/live-backends.integration.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.11.0",
    "flag-icons": "^7.5.0",
    "roboto-fontface": "^0.10.0",
    "vue": "^3.5.28",
    "vuetify": "^4.1.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.18.6",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vue/compiler-sfc": "^3.5.28",
    "@vue/tsconfig": "^0.8.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.9.0",
    "html-webpack-plugin": "^5.6.6",
    "mini-css-extract-plugin": "^2.10.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.2.4",
    "web-ext": "^8.10.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
